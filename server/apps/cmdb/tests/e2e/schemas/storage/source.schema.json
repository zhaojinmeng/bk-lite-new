{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["success", "result"],
  "properties": {
    "success": {"const": true},
    "result": {
      "type": "object",
      "required": ["storage"],
      "additionalProperties": false,
      "properties": {
        "storage": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["device_sn", "brand", "storage_type", "total_capacity", "used_capacity", "available_capacity", "pool_count", "disk_count", "volume_count", "RUNNINGSTATUS"],
            "properties": {
              "device_sn": {"const": "device-contract"},
              "brand": {"const": "huawei"},
              "storage_type": {"const": "SAN"},
              "total_capacity": {"const": "2"},
              "used_capacity": {"const": "1"},
              "available_capacity": {"const": "1"},
              "pool_count": {"const": "1"},
              "disk_count": {"const": "1"},
              "volume_count": {"const": "1"},
              "RUNNINGSTATUS": {"const": "27"}
            },
            "additionalProperties": true
          }
        }
      }
    }
  },
  "additionalProperties": false
}

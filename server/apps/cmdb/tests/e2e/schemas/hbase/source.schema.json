{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "success",
    "result"
  ],
  "properties": {
    "success": {
      "const": true
    },
    "result": {
      "type": "object",
      "required": [
        "hbase"
      ],
      "additionalProperties": false,
      "properties": {
        "hbase": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "inst_name",
              "ip_addr",
              "port",
              "version",
              "cluster_distributed"
            ],
            "additionalProperties": {
              "type": [
                "string",
                "number",
                "integer",
                "boolean",
                "null"
              ]
            },
            "properties": {
              "inst_name": {
                "type": "string"
              },
              "ip_addr": {
                "type": "string"
              },
              "port": {
                "type": "string"
              },
              "version": {
                "type": "string"
              },
              "cluster_distributed": {
                "type": "string"
              }
            },
            "x-drift-policy": {
              "unknown_scalar_fields": "report_non_blocking",
              "unknown_nested_fields": "reject"
            }
          }
        }
      }
    }
  },
  "additionalProperties": false
}

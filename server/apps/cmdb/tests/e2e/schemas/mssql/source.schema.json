{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "success",
    "result"
  ],
  "properties": {
    "success": {
      "const": true
    },
    "result": {
      "type": "object",
      "required": [
        "mssql"
      ],
      "additionalProperties": false,
      "properties": {
        "mssql": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "inst_name",
              "ip_addr",
              "port",
              "version",
              "max_conn",
              "max_mem_mb",
              "order_rule",
              "fill_factor",
              "boot_account"
            ],
            "additionalProperties": {
              "type": [
                "string",
                "number",
                "integer",
                "boolean",
                "null"
              ]
            },
            "properties": {
              "inst_name": {
                "type": "string"
              },
              "ip_addr": {
                "type": "string"
              },
              "port": {
                "type": "string"
              },
              "version": {
                "type": "string"
              },
              "max_conn": {
                "type": "integer"
              },
              "max_mem_mb": {
                "type": "integer"
              },
              "order_rule": {
                "type": "string"
              },
              "fill_factor": {
                "type": "integer"
              },
              "boot_account": {
                "type": "string"
              }
            },
            "x-drift-policy": {
              "unknown_scalar_fields": "report_non_blocking",
              "unknown_nested_fields": "reject"
            }
          }
        }
      }
    }
  },
  "additionalProperties": false
}

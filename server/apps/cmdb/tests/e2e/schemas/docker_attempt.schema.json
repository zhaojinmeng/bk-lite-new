{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "case_id",
    "kind",
    "started_at",
    "finished_at",
    "command",
    "working_directory",
    "docker_context",
    "image",
    "platform",
    "image_digest",
    "resource_identifier",
    "container_id",
    "stdout",
    "stderr",
    "exit_code",
    "outcome",
    "failure_stage",
    "sanitized",
    "cleanup"
  ],
  "properties": {
    "case_id": {"type": "string", "minLength": 1},
    "kind": {
      "enum": [
        "image_pull",
        "collector_cli",
        "service_and_collector",
        "network_boundary"
      ]
    },
    "started_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": "string", "format": "date-time"},
    "command": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "working_directory": {
      "type": "string",
      "minLength": 1,
      "not": {"pattern": "^/"}
    },
    "docker_context": {"type": "string", "minLength": 1},
    "image": {"type": "string", "minLength": 1},
    "platform": {"type": "string", "minLength": 1},
    "image_digest": {"type": ["string", "null"]},
    "resource_identifier": {"type": "string", "minLength": 1},
    "container_id": {"type": ["string", "null"]},
    "stdout": {"type": "string"},
    "stderr": {"type": "string"},
    "exit_code": {"type": "integer", "not": {"const": 0}},
    "outcome": {"const": "failed"},
    "failure_stage": {
      "enum": [
        "image_pull",
        "container_start",
        "service_install",
        "service_ready",
        "collector",
        "network_protocol"
      ]
    },
    "sanitized": {"const": true},
    "cleanup": {
      "type": "object",
      "required": [
        "action",
        "command",
        "exit_code",
        "stdout",
        "stderr",
        "residual_query",
        "residual_exit_code",
        "residual_stdout",
        "residual_stderr",
        "residual_count"
      ],
      "properties": {
        "action": {
          "enum": ["remove_container", "verify_absent"]
        },
        "command": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "exit_code": {"const": 0},
        "stdout": {"type": "string"},
        "stderr": {"type": "string"},
        "residual_query": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "prefixItems": [
            {"const": "docker"},
            {"const": "ps"},
            {"const": "-aq"},
            {"const": "--filter"},
            {"type": "string", "pattern": "^(id=[0-9a-f]{12,64}|name=\\^/[A-Za-z0-9][A-Za-z0-9_.-]*\\$)$"}
          ]
        },
        "residual_exit_code": {"const": 0},
        "residual_stdout": {"type": "string"},
        "residual_stderr": {"type": "string"},
        "residual_count": {"const": 0}
      },
      "allOf": [
        {
          "if": {
            "properties": {"action": {"const": "remove_container"}},
            "required": ["action"]
          },
          "then": {
            "properties": {
              "command": {
                "type": "array",
                "minItems": 4,
                "maxItems": 4,
                "prefixItems": [
                  {"const": "docker"},
                  {"const": "rm"},
                  {"const": "-f"},
                  {"type": "string", "minLength": 1}
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {"action": {"const": "verify_absent"}},
            "required": ["action"]
          },
          "then": {
            "properties": {
              "command": {
                "type": "array",
                "minItems": 5,
                "maxItems": 5,
                "prefixItems": [
                  {"const": "docker"},
                  {"const": "ps"},
                  {"const": "-aq"},
                  {"const": "--filter"},
                  {"type": "string", "pattern": "^(id=[0-9a-f]{12,64}|name=\\^/[A-Za-z0-9][A-Za-z0-9_.-]*\\$)$"}
                ]
              }
            }
          }
        }
      ],
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}

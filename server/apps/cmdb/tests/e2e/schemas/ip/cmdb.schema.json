{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "model_id",
    "instance_count_min",
    "review_basis",
    "source_contract_model_id",
    "write_mode",
    "expected_vm_metric_subset"
  ],
  "additionalProperties": false,
  "properties": {
    "model_id": {
      "const": "ip"
    },
    "source_contract_model_id": {
      "type": "string",
      "minLength": 1
    },
    "write_mode": {
      "enum": [
        "graph_entity",
        "embedded_host_field",
        "dynamic_model_entity",
        "model_alias_entity",
        "ipam_service"
      ]
    },
    "instance_count_min": {
      "type": "integer",
      "minimum": 0
    },
    "expected_instance_subset": {
      "type": "object",
      "required": [
        "inst_name"
      ],
      "minProperties": 2,
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "integer",
          "boolean",
          "null",
          "array",
          "object"
        ]
      }
    },
    "expected_process_subset": {
      "type": "object",
      "minProperties": 2,
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "integer",
          "boolean",
          "null",
          "array",
          "object"
        ]
      }
    },
    "expected_vm_metric_subset": {
      "type": "object",
      "minProperties": 2,
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "integer",
          "boolean",
          "null",
          "array",
          "object"
        ]
      }
    },
    "review_basis": {
      "type": "string",
      "minLength": 12
    },
    "migration_source": {
      "type": "string",
      "minLength": 1
    }
  }
}

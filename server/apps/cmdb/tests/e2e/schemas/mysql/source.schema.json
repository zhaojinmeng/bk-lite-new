{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["success", "result"],
  "properties": {
    "success": {"const": true},
    "result": {
      "type": "object",
      "required": ["mysql"],
      "properties": {
        "mysql": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["ip_addr", "port", "version", "server_uuid"]
          }
        }
      }
    }
  }
}

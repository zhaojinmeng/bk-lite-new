{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "success",
    "result"
  ],
  "properties": {
    "success": {
      "const": true
    },
    "result": {
      "type": "object",
      "required": [
        "nic"
      ],
      "additionalProperties": false,
      "properties": {
        "nic": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "nic_pci_addr",
              "nic_name",
              "mac",
              "self_device"
            ],
            "properties": {
              "nic_pci_addr": {
                "type": "string"
              },
              "nic_name": {
                "type": "string"
              },
              "mac": {
                "type": "string"
              },
              "self_device": {
                "type": "string"
              }
            },
            "additionalProperties": {
              "type": [
                "string",
                "number",
                "integer",
                "boolean",
                "null"
              ]
            },
            "x-drift-policy": {
              "unknown_scalar_fields": "report_non_blocking",
              "unknown_nested_fields": "reject"
            }
          }
        }
      }
    }
  },
  "additionalProperties": false
}

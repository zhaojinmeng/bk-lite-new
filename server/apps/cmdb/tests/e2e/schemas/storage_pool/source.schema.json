{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["success", "result"],
  "properties": {
    "success": {"const": true},
    "result": {
      "type": "object",
      "required": ["storage_pool"],
      "additionalProperties": false,
      "properties": {
        "storage_pool": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["NAME", "USAGETYPE", "USERTOTALCAPACITY", "USERCONSUMEDCAPACITY", "USERFREECAPACITY", "SECTORSIZE", "RUNNINGSTATUS"],
            "properties": {
              "NAME": {"const": "pool-contract"},
              "USAGETYPE": {"type": "string"},
              "USERTOTALCAPACITY": {"type": "string"},
              "USERCONSUMEDCAPACITY": {"type": "string"},
              "USERFREECAPACITY": {"type": "string"},
              "SECTORSIZE": {"type": "string"},
              "RUNNINGSTATUS": {"type": "string"}
            },
            "additionalProperties": false
          }
        }
      }
    }
  },
  "additionalProperties": false
}

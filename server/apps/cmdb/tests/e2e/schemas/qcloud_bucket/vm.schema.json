{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "status",
    "data"
  ],
  "additionalProperties": false,
  "properties": {
    "status": {
      "const": "success"
    },
    "data": {
      "type": "object",
      "required": [
        "resultType",
        "result"
      ],
      "additionalProperties": false,
      "properties": {
        "resultType": {
          "const": "vector"
        },
        "result": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "metric",
              "value"
            ],
            "additionalProperties": false,
            "properties": {
              "metric": {
                "type": "object",
                "required": [
                  "__name__",
                  "collect_status",
                  "instance_id",
                  "model_id"
                ],
                "properties": {
                  "__name__": {
                    "type": "string",
                    "pattern": "_info_gauge$"
                  },
                  "collect_status": {
                    "const": "success"
                  },
                  "instance_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "model_id": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "additionalProperties": {
                  "type": "string"
                }
              },
              "value": {
                "type": "array",
                "items": [
                  {
                    "type": [
                      "integer",
                      "number"
                    ]
                  },
                  {
                    "type": "string"
                  }
                ],
                "minItems": 2,
                "maxItems": 2
              }
            }
          }
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["success", "result"],
  "properties": {
    "success": {"const": true},
    "result": {
      "type": "object",
      "required": ["storage_disk"],
      "additionalProperties": false,
      "properties": {
        "storage_disk": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["LOCATION", "MANUFACTURER", "MODEL", "DISKTYPE", "SECTORS", "SECTORSIZE", "SERIALNUMBER", "SPEEDRPM", "RUNNINGSTATUS"],
            "properties": {
              "LOCATION": {"const": "DAE000.A"},
              "MANUFACTURER": {"type": "string"},
              "MODEL": {"type": "string"},
              "DISKTYPE": {"type": "string"},
              "SECTORS": {"type": "string"},
              "SECTORSIZE": {"type": "string"},
              "SERIALNUMBER": {"type": "string"},
              "SPEEDRPM": {"type": "string"},
              "RUNNINGSTATUS": {"type": "string"}
            },
            "additionalProperties": false
          }
        }
      }
    }
  },
  "additionalProperties": false
}

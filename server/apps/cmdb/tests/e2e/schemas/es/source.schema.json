{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["success", "result"],
  "properties": {
    "success": {"const": true},
    "result": {
      "type": "object",
      "required": ["es"],
      "additionalProperties": false,
      "properties": {
        "es": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["inst_name", "ip_addr", "port", "version"],
            "properties": {
              "inst_name": {"const": "es.example.invalid"},
              "ip_addr": {"type": "string"},
              "port": {"type": "string"},
              "version": {"type": "string"}
            },
            "additionalProperties": true
          }
        }
      }
    }
  },
  "additionalProperties": false
}
